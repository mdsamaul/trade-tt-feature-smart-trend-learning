# ==============================================================================
# QUOTEX AUTONOMOUS PAPER-TRADING AGENT - CONFIGURATION
# ==============================================================================

# AI Vision API Configuration (OpenAI, xAI Grok, OpenRouter, or Local Ollama)
# If left blank, the system automatically uses the internal Heuristic Computer-Vision engine.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# For xAI Grok Vision:
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=grok-vision-beta

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Paper-Trading Parameters
INITIAL_BALANCE=10000.0
DEFAULT_TRADE_AMOUNT=100.0
PAYOUT_RATE=0.85
CANDLE_TIMEFRAME_SECONDS=60

# Strategy Optimizer Initial Strictness (1 to 6)
# 1 = Lenient (65% min confidence)
# 2 = Balanced (72% min confidence)
# 3 = Selective (78% min confidence)
# 4 = Defense (82% min confidence)
# 5 = Sniper Strictness (86% min confidence)
# 6 = Ultra Sniper 100% Confluence Zero-Loss Mode (90%+ min confidence)
DEFAULT_STRICTNESS=6

# Target Goal Settings (1.00 = 100% Win Rate / 5 wins out of 5 trades)
TARGET_ROLLING_WIN_RATE=1.00
ROLLING_WINDOW_SIZE=5
